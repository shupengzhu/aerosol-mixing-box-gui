[gas_species_aerosol_interact]
# Maps each aerosol species to the gas species it condenses from.
# Format: <aerosol_name> <gas_name>
# Only species with persistent CAM gas hosts and gas-aerosol exchange are listed.
# PMD, PBC, PNA, PH2O do not condense from gas phase.
