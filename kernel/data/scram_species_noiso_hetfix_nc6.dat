[gas_species_aerosol_interact]
# Maps each aerosol species to the gas species it condenses from.
# Format: <aerosol_name> <gas_name>
# Only species with persistent CAM gas hosts and gas-aerosol exchange are listed.
# PMD, PBC, PNA, PH2O do not condense from gas phase.
PSO4 SULF
PSOA1P SOA1P
PSOA2P SOA2P
PSOA3P SOA3P
PSOA4P SOA4P
PSOA5P SOA5P

[molecular_weight_aer]
# Unit: g/mol (parser converts to microg/mol by multiplying 1e6)
PMD 28.0 PBC 12.0 PNA 23.0 PSO4 98.0 PSOA1P 250.0
PSOA2P 250.0 PSOA3P 250.0 PSOA4P 250.0 PSOA5P 250.0 PPOAlP 280.0
PH2O 18.0

[molecular_diameter_aer]
# Unit: Angstrom (passed directly to gas diffusivity routine)
PSO4 5.5
PSOA1P 8.39 PSOA2P 8.39 PSOA3P 8.39 PSOA4P 8.39 PSOA5P 8.39

[collision_factor_aer]
