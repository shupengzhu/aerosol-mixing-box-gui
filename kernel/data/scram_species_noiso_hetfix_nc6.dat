PSOA1P 687.0 PSOA2P 687.0 PSOA3P 687.0 PSOA4P 687.0 PSOA5P 687.0

[saturation_pressure]
# Saturation pressure (Pa) at 298 K; SOA values match C*=0.01,0.1,1,10,100 ug m-3
PSOA1P 9.88e-8 PSOA2P 9.88e-7 PSOA3P 9.88e-6 PSOA4P 9.88e-5 PSOA5P 9.88e-4

[partition_coefficient]
# Partition coefficient (m^3.microg^-1) at 298 K; SOA only
PSOA1P 100.0 PSOA2P 10.0 PSOA3P 1.0 PSOA4P 0.1 PSOA5P 0.01

[vaporization_enthalpy]
# Vaporization enthalpy (J/mol) at 298 K
